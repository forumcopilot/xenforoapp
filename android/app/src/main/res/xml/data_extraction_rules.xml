<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules). Same reasoning as backup_rules.xml:
     the secure-storage file is useless without this device's Keystore key,
     so it is excluded from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
